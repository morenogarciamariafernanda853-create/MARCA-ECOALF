function NetThread({ color = C.teal, width = 220, height = 16 }) {
  return (
    <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} fill="none">
      <path
        d={`M0 ${height / 2} Q ${width * 0.125} 0, ${width * 0.25} ${height / 2} T ${width * 0.5} ${height / 2} T ${width * 0.75} ${height / 2} T ${width} ${height / 2}`}
        stroke={color}
        strokeWidth="1.5"
        strokeDasharray="1 7"
        strokeLinecap="round"
      />
    </svg>
  );
}

function StatCard({ label, value, unit, accent }) {
  return (
    <div className="rounded-2xl p-3 flex flex-col justify-between" style={{ background: C.paper, border: `1px solid ${C.sand}` }}>
