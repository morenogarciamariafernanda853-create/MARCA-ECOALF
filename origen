  return (
    <div className="flex flex-col h-full px-5 pt-3 pb-4 overflow-y-auto">
      <Label>Circular Hub</Label>
      <h2 className="text-lg mt-0.5 mb-3" style={{ color: C.navy, fontFamily: "'Fraunces', serif", fontWeight: 600 }}>
        Chaqueta Bering · 2 años de uso
