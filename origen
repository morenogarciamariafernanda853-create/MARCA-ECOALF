/* ---------- 2. IMPACT SCORE (anillos estilo Fitness) ---------- */

function Ring({ pct, color, size = 84, stroke = 10 }) {
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  return (
    <svg width={size} height={size} style={{ transform: "rotate(-90deg)" }}>
      <circle cx={size / 2} cy={size / 2} r={r} stroke={C.sand} strokeWidth={stroke} fill="none" opacity="0.5" />
      <circle
        cx={size / 2} cy={size / 2} r={r} stroke={color} strokeWidth={stroke} fill="none"
        strokeDasharray={c} strokeDashoffset={c - (Math.min(pct, 100) / 100) * c} strokeLinecap="round"
        style={{ transition: "stroke-dashoffset 0.6s ease" }}
      />
    </svg>
  );
}

function RingRow({ icon, label, value, unit, pct, color }) {
  return (
    <div className="flex items-center gap-3 rounded-2xl p-2.5" style={{ background: C.paper, border: `1px solid ${C.sand}` }}>
      <div className="relative shrink-0" style={{ width: 56, height: 56 }}>
        <Ring pct={pct} color={color} size={56} stroke={7} />
        <span className="absolute inset-0 flex items-center justify-center text-base">{icon}</span>
      </div>
      <div>
        <p className="text-[10px] uppercase" style={{ color: C.tealDeep, fontFamily: "'Space Grotesk', sans-serif", letterSpacing: "0.06em" }}>{label}</p>
        <p style={{ color: C.navy, fontFamily: "'Fraunces', serif", fontSize: 18, fontWeight: 600 }}>
          {value} <span style={{ fontSize: 11, color: C.ink, opacity: 0.6, fontFamily: "'Space Grotesk', sans-serif" }}>{unit}</span>
        </p>
      </div>
    </div>
  );
}

function ImpactoScreen() {
  const [score, setScore] = useState(1240);
  const [bump, setBump] = useState(null);

  const actions = [
    { key: "reparar", label: "Reparar una prenda", points: 40 },
    { key: "revender", label: "Revender en el Circular Hub", points: 60 },
    { key: "extender", label: "Extender un año de vida útil", points: 30 },
  ];

  const level = score >= 1500 ? 3 : score >= 900 ? 2 : 1;
  const levelLabel = ["Guardián nivel 1", "Guardián nivel 2", "Guardián nivel 3"][level - 1];

  function addPoints(a) {
    setScore((s) => s + a.points);
    setBump(a.key);
    setTimeout(() => setBump(null), 700);
  }

  return (
    <div className="flex flex-col h-full px-5 pt-3 pb-4 overflow-y-auto">
      <Label>Mi impacto</Label>
      <div className="flex items-end justify-between mt-1 mb-3">
        <h2 className="text-3xl" style={{ color: C.navy, fontFamily: "'Fraunces', serif", fontWeight: 600 }}>
          {score.toLocaleString("es-ES")}
        </h2>
        <span className="text-xs mb-1 px-2.5 py-1 rounded-full" style={{ background: C.sand, color: C.navy, fontFamily: "'Space Grotesk', sans-serif" }}>
          {levelLabel}
        </span>
      </div>

      <div className="flex flex-col gap-2 mb-4">
        <RingRow icon="🌍" label="CO₂ evitado" value="86" unit="kg" pct={72} color={C.teal} />
        <RingRow icon="⏳" label="Vida útil ganada" value="3.5" unit="años" pct={55} color={C.ringBlue} />
        <RingRow icon="♻️" label="Residuo recuperado" value="12" unit="kg" pct={90} color={C.rust} />
      </div>

      <Label style={{ marginBottom: 6 }}>Cómo sumar más puntos</Label>
      <div className="flex flex-col gap-2">
        {actions.map((a) => (
          <button
            key={a.key}
            onClick={() => addPoints(a)}
            className="flex items-center justify-between px-3 py-2.5 rounded-xl text-left transition-transform"
            style={{ background: C.paper, border: `1px solid ${C.sand}`, transform: bump === a.key ? "scale(0.97)" : "scale(1)" }}
          >
            <span className="text-xs" style={{ color: C.ink, fontFamily: "'Space Grotesk', sans-serif" }}>{a.label}</span>
            <span className="text-xs font-semibold px-2 py-0.5 rounded-full" style={{ background: C.teal, color: C.paper }}>+{a.points}</span>
          </button>
        ))}
      </div>
    </div>
  );
}

