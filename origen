        style={{ background: C.navy, color: C.paper, fontFamily: "'Space Grotesk', sans-serif" }}
      >
        {step >= HUB_STEPS.length - 1 ? "Proceso completado" : `Marcar "${HUB_STEPS[step + 1]}"`}
